# ==============================================================================
# KONFIGURASI DOCKER & DATABASE OPENSID SAAS DISKOMINFO (BEBAS BENTROK)
# ==============================================================================

# Port Web Server Host (Akses dari Browser Laptop / VPS)
APP_PORT=8090
PMA_PORT=8091
DB_PORT=3308

# Konfigurasi Database (MariaDB / MySQL)
DB_HOST=db
DB_DATABASE=opensid_bobu
DB_USERNAME=opensid_user
DB_PASSWORD=opensid_password
DB_ROOT_PASSWORD=opensid_root_secret

# Informasi Instansi & Pilot Desa
KABUPATEN=Banggai Kepulauan
KECAMATAN=Tinangkung Selatan
DESA_PILOT=Desa Bobu
SUBDOMAIN_PILOT=bobu.banggaikep.go.id

# Mode Aplikasi
CI_ENV=development
APP_DEBUG=true
